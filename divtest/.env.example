# divtest — local secrets (never commit)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=http://localhost:3847/api/upstox/callback
UPSTOX_TOKEN_FILE=

# Server
DIVTEST_PORT=3847
DIVTEST_DEMO_MODE=0

# Protect public deployment (recommended)
DIVTEST_BASIC_AUTH_USER=
DIVTEST_BASIC_AUTH_PASS=
# Comma-separated IPs; empty = allow all
DIVTEST_IP_ALLOWLIST=
